---
import EventsPage from "../components/Events/EventsPage";
import { staticT } from "../i18n";
import Layout from "../layouts/Layout.astro";
const title = staticT("seo.pages.events");
const pathName = "/events";
import { sanityClient } from "sanity:client";
const query = `*[_type == "event"] | order(start desc)`;
const shouldShowEvent = (event: Record<string, unknown>) => {
	const searchableText = JSON.stringify(event).toLowerCase();
	return !searchableText.includes("hacker series") && !searchableText.includes("hackerseries");
};
const events = (await sanityClient.fetch(query)).filter(shouldShowEvent);
---

<Layout title={title} pathName={pathName}>
	<EventsPage events={events} client:load />
</Layout>
